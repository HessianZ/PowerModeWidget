<Window x:Class="PowerModeWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Mode Widget" Width="388" Height="170"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="False" ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#F2F3F8">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#939BAF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#293044" />
                                <Setter Property="Foreground" Value="#F2F3F8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E0D8FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C0D0" />
            <Setter Property="Background" Value="#232A3A" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="#344056" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#303A50" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Surface" Property="Background" Value="#BBA6FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D5C8FF" />
                                <Setter Property="Foreground" Value="#211B35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#171D2B" BorderBrush="#3D465C" BorderThickness="1" CornerRadius="17" Padding="17,12,17,13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="14" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <TextBlock Text="电源模式" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}" Click="CloseButton_Click"
                        HorizontalAlignment="Right" ToolTip="退出" AutomationProperties.Name="退出">
                    <Path Data="M 3,3 L 13,13 M 13,3 L 3,13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Width="16" Height="16" />
                </Button>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="EfficiencyButton" Content="省电" Style="{StaticResource ModeButton}"
                        Click="EfficiencyButton_Click" AutomationProperties.Name="最佳能效" />
                <Button x:Name="BalancedButton" Grid.Column="2" Content="平衡" Style="{StaticResource ModeButton}"
                        Click="BalancedButton_Click" AutomationProperties.Name="平衡" />
                <Button x:Name="PerformanceButton" Grid.Column="4" Content="性能" Style="{StaticResource ModeButton}"
                        Click="PerformanceButton_Click" AutomationProperties.Name="最佳性能" />
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="2,0,0,0">
                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#939BAF" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="正在读取电源模式…" Foreground="#A6AFC2" FontSize="11"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
