<UserControl x:Class="PowerModeWidget.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="192" Height="42" Background="Transparent"
             MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp" LostMouseCapture="Window_LostMouseCapture"
             FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#F2F3F8">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ExitMenuItem" Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.Resources>
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#B9C0D0" />
            <Setter Property="Background" Value="#232A3A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="#344056" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#303A50" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Surface" Property="Background" Value="#BBA6FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D5C8FF" />
                                <Setter Property="Foreground" Value="#211B35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#171D2B" BorderBrush="#3D465C" BorderThickness="1" CornerRadius="10" Padding="4"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="4" />
                <ColumnDefinition />
                <ColumnDefinition Width="4" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button x:Name="EfficiencyButton" Content="省电" Style="{StaticResource ModeButton}"
                    Click="EfficiencyButton_Click" ToolTip="最佳能效" AutomationProperties.Name="最佳能效" />
            <Button x:Name="BalancedButton" Grid.Column="2" Content="平衡" Style="{StaticResource ModeButton}"
                    Click="BalancedButton_Click" ToolTip="平衡" AutomationProperties.Name="平衡" />
            <Button x:Name="PerformanceButton" Grid.Column="4" Content="性能" Style="{StaticResource ModeButton}"
                    Click="PerformanceButton_Click" ToolTip="最佳性能" AutomationProperties.Name="最佳性能" />
        </Grid>
    </Border>
</UserControl>
